# Copie este arquivo como .env.local e preencha com os valores públicos do Supabase.
# Nunca inclua a service_role ou a senha do banco neste arquivo.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_publica

# Configure apenas na Vercel. Nunca use este valor no navegador ou no .env.local.
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_secreta
